# Docker Compose Environment Variables
# Copy this file to .env in the same directory
# IMPORTANT: The .env file will be gitignored - never commit it!

# PostgreSQL Development
POSTGRES_DEV_DB=omnitrackr_dev
POSTGRES_DEV_USER=dev_user
POSTGRES_DEV_PASSWORD=change_this_password
POSTGRES_DEV_PORT=5432

# PostgreSQL Test
POSTGRES_TEST_DB=omnitrackr_test
POSTGRES_TEST_USER=test_user
POSTGRES_TEST_PASSWORD=change_this_password
POSTGRES_TEST_PORT=5433

# PgAdmin (optional)
PGADMIN_EMAIL=admin@omnitrackr.local
PGADMIN_PASSWORD=change_this_password
PGADMIN_PORT=5050
