              "raw": "{\n  \"source_connection_id\": 1,\n  \"schedule_id\": 1,\n  \"department_code\": \"DEPARTMENT:Finance\",\n  \"name\": \"Daily Sales Report Watcher\",\n  \"description\": \"Monitors for daily sales reports\",\n  \"file_name_pattern\": \"sales_*.csv\",\n  \"file_path_pattern\": \"/reports/sales/\",\n  \"match_rule\": \"partial\",\n  \"sla_enabled\": true,\n  \"sla_threshold_minutes\": 120,\n  \"direction\": \"inward\",\n  \"owner_team\": \"Finance Team\",\n  \"status\": \"active\"\n}"
