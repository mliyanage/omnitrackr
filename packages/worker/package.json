{
  "name": "@omnitrackr/worker",
  "version": "1.0.0",
  "description": "OmniTrackr polling worker - executes scheduled file checks and SLA monitoring",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
