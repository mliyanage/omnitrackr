# Development Environment Configuration
# This file CAN be committed - contains NO secrets!
# Create .env.development.local for actual credentials

NODE_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Database connection (credentials in .env.development.local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnitrackr_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# Worker Configuration
POLLING_WORKER_ENABLED=true
SLA_MONITOR_ENABLED=true

# Polling Worker Settings
POLLING_INTERVAL_SECONDS=60
POLLING_BATCH_SIZE=50
POLLING_TIMEOUT_MS=300000

# SLA Monitor Settings
SLA_CHECK_INTERVAL_SECONDS=300
SLA_LOOKBACK_HOURS=24

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=5000

# Graceful Shutdown
SHUTDOWN_TIMEOUT_MS=30000
