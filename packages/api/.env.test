# Test Environment Configuration
# This file CAN be committed - contains NO secrets!
# Create .env.test.local for actual test credentials

NODE_ENV=test
PORT=3002
LOG_LEVEL=error
LOG_FORMAT=json

# Database connection (credentials in .env.test.local)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=omnitrackr_test
DB_POOL_MIN=1
DB_POOL_MAX=5

# Use encrypted DB for tests
SECRETS_PROVIDER=encrypted_db

# CORS
CORS_ORIGIN=http://localhost:3003

# Rate limiting (high limit for tests)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=10000

# Features disabled in test
ENABLE_SWAGGER=false
ENABLE_METRICS=false
ENABLE_DEBUG_ROUTES=false

# Logging (minimal)
LOG_TO_FILE=false

# JWT expiry
JWT_EXPIRY=1h

# AWS region (if using AWS)
AWS_REGION=us-east-1
