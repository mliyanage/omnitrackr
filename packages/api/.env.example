# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnitrackr
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Secrets Management
# Options: encrypted_db, aws, gcp, azure, vault
SECRETS_PROVIDER=encrypted_db
ENCRYPTION_MASTER_KEY=  # 64-char hex key for encrypted_db mode

# AWS (if using AWS secrets manager or S3)
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_PREFIX=omnitrackr/

# GCP (if using GCP)
GCP_PROJECT=
GCP_SECRET_MANAGER_PREFIX=omnitrackr-

# Azure (if using Azure)
AZURE_TENANT_ID=
AZURE_KEY_VAULT_URL=

# HashiCorp Vault (if using Vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# Authentication & Security
JWT_SECRET=your-secret-key-here-change-in-production-min-32-chars
JWT_EXPIRY=24h
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Password Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
MAX_CONCURRENT_SESSIONS=5

# Email Service (Mailjet REST API)
# Get your API keys from https://app.mailjet.com/account/apikeys
MJ_APIKEY_PUBLIC=your-mailjet-api-key
MJ_APIKEY_PRIVATE=your-mailjet-secret-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=OmniTrackr
APP_URL=http://localhost:5173

# 2FA Configuration
TOTP_WINDOW=1
TOTP_ISSUER=OmniTrackr
BACKUP_CODES_COUNT=10

# Default Users (for Phase 6 data migration)
SUPER_ADMIN_EMAIL=superadmin@omnitrackr.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!
ORG_OWNER_EMAIL=owner@omnitrackr.local
ORG_OWNER_PASSWORD=OrgOwner123!

# Logging
LOG_LEVEL=info  # Options: error, warn, info, debug
LOG_FORMAT=json  # Options: json, simple

# CORS
CORS_ORIGIN=http://localhost:5173  # Frontend URL

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
