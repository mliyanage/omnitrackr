# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnitrackr
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Secrets Management
# Options: encrypted_db, aws, gcp, azure, vault
SECRETS_PROVIDER=encrypted_db
ENCRYPTION_MASTER_KEY=  # 64-char hex key for encrypted_db mode

# AWS (if using AWS secrets manager or S3)
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_PREFIX=omnitrackr/

# GCP (if using GCP)
GCP_PROJECT=
GCP_SECRET_MANAGER_PREFIX=omnitrackr-

# Azure (if using Azure)
AZURE_TENANT_ID=
AZURE_KEY_VAULT_URL=

# HashiCorp Vault (if using Vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# Authentication
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=info  # Options: error, warn, info, debug
LOG_FORMAT=json  # Options: json, simple

# CORS
CORS_ORIGIN=http://localhost:5173  # Frontend URL

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
