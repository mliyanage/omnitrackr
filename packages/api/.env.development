# Development Environment Configuration
# This file CAN be committed - contains NO secrets!
# Create .env.development.local for actual credentials

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Database connection (credentials in .env.development.local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnitrackr_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# Use encrypted DB for local dev
SECRETS_PROVIDER=encrypted_db

# CORS - allow local frontend
CORS_ORIGIN=http://localhost:5173

# Rate limiting (relaxed for dev)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=1000

# Features enabled in dev
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_DEBUG_ROUTES=true

# Logging
LOG_TO_FILE=false

# JWT Configuration
JWT_EXPIRY=24h
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
# JWT_SECRET should be set in .env.development.local (min 32 chars)

# Password Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
MAX_CONCURRENT_SESSIONS=5

# Email Configuration (Mailjet REST API - set actual credentials in .env.development.local)
# MJ_APIKEY_PUBLIC should be set in .env.development.local
# MJ_APIKEY_PRIVATE should be set in .env.development.local
# FROM_EMAIL should be set in .env.development.local (use authorized domain)
# FROM_NAME should be set in .env.development.local
APP_URL=http://localhost:5173

# 2FA Configuration
TOTP_WINDOW=1
TOTP_ISSUER=OmniTrackr
BACKUP_CODES_COUNT=10

# Default Users (for Phase 6 data migration)
SUPER_ADMIN_EMAIL=superadmin@omnitrackr.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!
ORG_OWNER_EMAIL=owner@omnitrackr.local
ORG_OWNER_PASSWORD=OrgOwner123!

# AWS region (if using AWS)
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_PREFIX=omnitrackr/dev/
