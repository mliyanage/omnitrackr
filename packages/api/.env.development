# Development Environment Configuration
# This file CAN be committed - contains NO secrets!
# Create .env.development.local for actual credentials

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Database connection (credentials in .env.development.local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnitrackr_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# Use encrypted DB for local dev
SECRETS_PROVIDER=encrypted_db

# CORS - allow local frontend
CORS_ORIGIN=http://localhost:3001

# Rate limiting (relaxed for dev)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=1000

# Features enabled in dev
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_DEBUG_ROUTES=true

# Logging
LOG_TO_FILE=false

# JWT expiry
JWT_EXPIRY=24h

# AWS region (if using AWS)
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_PREFIX=omnitrackr/dev/
